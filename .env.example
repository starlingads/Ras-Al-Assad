# ─── Sanity ──────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the project ID.
# The same variables must also be set on Vercel (Project → Settings → Environment
# Variables) for preview and production deployments.
#
# To create the project (once, under the StarlingAds Sanity account):
#   npx sanity login
#   npx sanity init --project-name "Ras Al Assad" --dataset production
#
# An existing project's ID is listed at https://sanity.io/manage

# Public identifiers — safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Content Lake API version, pinned by date. Changing this is a deliberate act;
# see src/sanity/env.ts.
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-01

# ─── Secrets — never prefix with NEXT_PUBLIC_, never commit ───────────────
# Viewer token used for draft previews and the Live Content API (added in
# Phase 5). Create at https://sanity.io/manage → API → Tokens, role "Viewer".
SANITY_API_READ_TOKEN=

# ─── Enquiry email (Microsoft 365 / Exchange Online SMTP) ────────────────
# Used by the four enquiry endpoints under /api/enquiry/*. Server-side only —
# these are read in `src/server/mail/transport.ts`, which is marked
# `server-only`, so they can never reach the browser bundle.
#
# Office 365 uses STARTTLS on port 587 (there is no implicit-TLS 465 endpoint).
# SMTP_USER must be a real licensed mailbox, and SMTP AUTH must be enabled for
# it (Microsoft 365 admin centre → Users → Mail → Manage email apps →
# "Authenticated SMTP"). If the tenant enforces MFA/security defaults, create an
# App Password for this mailbox and use that as SMTP_PASSWORD — a normal account
# password will be rejected.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# The From address. Exchange Online only permits a From the authenticated
# mailbox owns (itself, or an address it has SendAs rights on). Defaults to
# SMTP_USER when blank. Do NOT put the visitor's address here — that would fail
# SPF/DMARC; their address goes in Reply-To instead.
MAIL_FROM=

# Where enquiries are delivered (the Ras Al Assad mailbox).
MAIL_TO=
